{
  "name": "@unocss/inspector",
  "type": "module",
  "version": "66.11.0",
  "description": "The inspector UI for UnoCSS",
  "author": "Anthony Fu <anthonyfu117@hotmail.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/antfu",
  "homepage": "https://unocss.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unocss/unocss.git",
    "directory": "packages-integrations/inspector"
  },
  "bugs": {
    "url": "https://github.com/unocss/unocss/issues"
  },
  "keywords": [
    "unocss",
    "inspector",
    "debugger"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./devframe": "./dist/devframe.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*.d.mts",
        "./dist/*.d.cts",
        "./*"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@unocss/autocomplete": "66.11.0",
    "@unocss/config": "66.11.0",
    "@unocss/core": "66.11.0",
    "@unocss/language-server": "66.11.0",
    "@unocss/rule-utils": "66.11.0",
    "devframe": "^1.2.3",
    "tinyglobby": "^0.2.17",
    "unplugin-utils": "^0.3.2"
  },
  "devDependencies": {
    "@iconify-json/catppuccin": "^1.2.17",
    "shiki": "^4.5.0",
    "vue-clamp": "^1.7.2",
    "vue-flow-layout": "^0.2.0"
  },
  "scripts": {
    "build": "tsdown --config-loader unrun",
    "build-post": "vite build",
    "dev": "tsdown --config-loader unrun --watch",
    "dev:client": "vite",
    "update-post": "vite build"
  }
}