{
  "name": "lz-string-es",
  "type": "module",
  "version": "1.0.0",
  "description": "An ESM-only build of lz-string, recompiled from the upstream source",
  "author": "Anthony Fu <anthonyfu117@hotmail.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/antfu",
  "homepage": "https://github.com/antfu/lz-string-es#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antfu/lz-string-es.git"
  },
  "bugs": "https://github.com/antfu/lz-string-es/issues",
  "keywords": [
    "lz-string",
    "lz",
    "compression",
    "string",
    "esm"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts-info": {
    "build": "Build the library for publishing",
    "dev": "Rebuild on change during development",
    "knip": "Find unused files, exports and dependencies",
    "lint": "Check for code style issues",
    "prepack": "Build before publishing",
    "release": "Bump version and publish a release",
    "start": "Run the entry file",
    "test": "Run the test suite",
    "typecheck": "Check types",
    "ci": "Run the full continuous integration pipeline",
    "prepare": "Init the upstream submodule, git hooks and skills"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@antfu/ni": "^30.6.0",
    "@antfu/skills": "^0.1.0",
    "@antfu/utils": "^9.3.0",
    "@types/node": "^26.6.3",
    "bumpp": "^12.3.0",
    "eslint": "^10.11.0",
    "eslint-plugin-slop": "^0.1.3",
    "eslint-plugin-sonarjs": "^4.2.2",
    "knip": "^6.38.0",
    "lz-string": "^1.5.0",
    "nano-staged": "^1.0.2",
    "publint": "^0.3.24",
    "simple-git-hooks": "^2.14.0",
    "skills-npm": "^4.0.0",
    "taze": "^21.2.0",
    "tsdown": "^0.23.0",
    "tsdown-stale-guard": "^0.1.3",
    "tsnapi": "^1.5.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm i --frozen-lockfile --ignore-scripts --offline && pnpm run ci && pnpx nano-staged"
  },
  "nano-staged": {
    "*.{js,ts,tsx,json,css,md,yaml,vue}": "eslint --fix --no-warn-ignored"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "knip": "knip",
    "lint": "eslint --cache",
    "release": "bumpp",
    "start": "tsx src/index.ts",
    "test": "pnpm run build && vitest",
    "typecheck": "tsc",
    "ci": "pnpm run lint && pnpm run typecheck && pnpm run knip && pnpm run test --run"
  }
}